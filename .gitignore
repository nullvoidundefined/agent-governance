node_modules/
*.log
.DS_Store
# Claude Code's built-in worktrees for this repo (a session's scratch checkouts).
.claude/worktrees/
# Lane worktrees created inside the repo rather than as sibling directories,
# which is where they belong: a sibling clutters the folder a human browses.
# Untracked and unignored, `git add -A` embeds them as nested repositories and
# git warns about submodules, which is how this was noticed (2026-09-18).
.worktrees/
# task-start's per-repo ledger (claude/skills/task-start/scripts/task-tier.sh):
# session-local state, never a fixture or a tracked artifact.
.claude/task-tier.json

# enforce/tdd.sh's slice lock (R-410's gate input): session-local state like
# the ledger above it. It was committed by accident in 321a9f1 (#89), which
# left a stale phase-green lock in the repository and blocked the next
# session's `tdd.sh open` until it was closed by hand.
.claude/tdd-lock.json

# Python bytecode from running hook helpers such as hooks/shell-command-segments.py.
__pycache__/
