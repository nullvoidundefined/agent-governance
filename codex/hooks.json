{
  "description": "Claude Code hooks under Codex; generated by openai/build.mjs from settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh secret-scan no-em-dash fix-commit-requires-test conflict-markers commit-message-guard destructive-db-guard destructive-command-guard global-repo-push-guard git-workflow-guard push-eslint-gate push-ruff-gate push-rubocop-gate push-golangci-gate constant-change-guard audit-signal-check llm-rule-judge single-file-folder-gate build-cheatsheets",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh secret-scan no-em-dash migration-defaults-guard structure-gate content-gate",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh mcp-action-guard destructive-db-guard",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh redact-output",
            "timeout": 60,
            "statusMessage": "Scanning output for secrets..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh new-file-header-reminder flat-directory-reminder spec-glossary-check",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh clean-code-reminder observability-reminder dockerfile-reminder",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh session-start hookspath-drift-check redaction-guard-check enforcement-guard-check parallel-session-check hook-integrity-check",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh post-compact-rules",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh session-end",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh verification-gate ntfy-notify",
            "timeout": 660
          }
        ]
      }
    ]
  }
}
