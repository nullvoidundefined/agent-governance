{
  "description": "Claude Code hooks under Codex; generated by translate/codex.mjs from settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh agent-dispatch-guard",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh secret-scan conflict-markers destructive-db-guard destructive-command-guard codex-billing-guard global-repo-push-guard git-workflow-guard destructive-ops-guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh secret-scan",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh mcp-action-guard destructive-db-guard",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh agent-watchdog-instruction",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh redact-output",
            "timeout": 60,
            "statusMessage": "Scanning output for secrets..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/codex-hook-adapter.sh harness-sync",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
