{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh sessionStart harness-sync",
        "timeout": 30
      }
    ],
    "beforeShellExecution": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh beforeShellExecution secret-scan conflict-markers destructive-db-guard destructive-command-guard codex-billing-guard global-repo-push-guard git-workflow-guard",
        "timeout": 180
      }
    ],
    "afterShellExecution": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh afterShellExecution redact-output",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh beforeMCPExecution mcp-action-guard destructive-db-guard",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh preToolUse secret-scan",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh afterFileEdit secret-scan",
        "timeout": 60
      }
    ],
    "beforeReadFile": [
      {
        "command": "~/.cursor/hooks/claude-hook-adapter.sh beforeReadFile",
        "timeout": 10
      }
    ]
  }
}
