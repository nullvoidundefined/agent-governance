{
  "_README": [
    "Template for ~/.claude/TICKET-TRACKER.json, the per-machine instance config the",
    "/ticket-lifecycle skill reads. Copy it to TICKET-TRACKER.json and fill it in.",
    "The real file is gitignored: a project key, a workspace ID, and a data source ID",
    "identify a client, and this repo is published (R-106). No token belongs in here",
    "either; the MCP server holds the auth (R-102).",
    "Set 'active' to one of the keys under 'trackers'. Tool names are whatever the MCP",
    "server on this machine actually exposes: read them from the tool list rather than",
    "assuming the placeholders below are right. The 'states' map is the only authority",
    "on provider status values; the skill never types one that is not in it.",
    "A tracker whose provider has no custom fields (Linear) carries the field set in the issue description and its extra states as labels; see that block's own _README."
  ],
  "active": "notion",
  "defaults": {
    "assist": "llm",
    "estimate_stale_after_days": 90,
    "estimate_min_sample": 5
  },
  "trackers": {
    "asana": {
      "container": {
        "project_gid": "<GID of the project holding tickets>",
        "workspace_gid": "<GID of the workspace>"
      },
      "fields": {
        "actual_minutes": "<custom field GID>",
        "assist": "<custom field GID>",
        "branch": "<custom field GID>",
        "estimate_minutes": "<custom field GID>",
        "human_estimate_minutes": "<custom field GID>",
        "human_speedup": "<custom field GID>",
        "estimate_ratio": "<custom field GID>",
        "model": "<custom field GID>",
        "repo": "<custom field GID>",
        "rework_count": "<custom field GID>",
        "tier": "<custom field GID>"
      },
      "states": {
        "backlog": "Backlog",
        "blocked": "Blocked",
        "done": "Done",
        "dropped": "Dropped",
        "in-progress": "In Progress",
        "in-review": "In Review",
        "planned": "Planned",
        "specced": "Specced"
      },
      "tools": {
        "comment": "<add-comment tool name>",
        "create": "<create-task tool name>",
        "read": "<get-task tool name>",
        "search": "<search-tasks tool name>",
        "update": "<update-task tool name>"
      }
    },
    "jira": {
      "container": {
        "issue_type": "Task",
        "project_key": "<PROJECT>"
      },
      "fields": {
        "actual_minutes": "customfield_<id>",
        "assist": "customfield_<id>",
        "branch": "customfield_<id>",
        "estimate_minutes": "customfield_<id>",
        "human_estimate_minutes": "customfield_<id>",
        "human_speedup": "customfield_<id>",
        "estimate_ratio": "customfield_<id>",
        "model": "customfield_<id>",
        "repo": "customfield_<id>",
        "rework_count": "customfield_<id>",
        "tier": "customfield_<id>"
      },
      "states": {
        "backlog": "Backlog",
        "blocked": "Blocked",
        "done": "Done",
        "dropped": "Won't Do",
        "in-progress": "In Progress",
        "in-review": "In Review",
        "planned": "Ready for Development",
        "specced": "Specced"
      },
      "tools": {
        "comment": "<add-comment tool name>",
        "create": "<create-issue tool name>",
        "read": "<get-issue tool name>",
        "search": "<JQL search tool name>",
        "update": "<update-issue tool name>"
      }
    },
    "linear": {
      "_README": [
        "Linear has no custom fields on the standard plan, so the canonical field set is",
        "written as 'key: value' lines inside a fenced ticket-fields block at the top of the",
        "issue description, ahead of the prose. Write only fields whose values are known;",
        "never emit a placeholder value. Three canonical states share the Linear status",
        "'In Progress' and two share 'Todo', so 'state_labels' is what disambiguates them:",
        "on every transition remove the previous state label before adding the new one,",
        "or an issue accumulates contradictory state labels."
      ],
      "container": {
        "team": "<team name or ID>",
        "project": "<project name holding these tickets, or null for none>"
      },
      "fields": {
        "mechanism": "description-block",
        "block_language": "ticket-fields",
        "order": [
          "tier",
          "assist",
          "model",
          "estimate_minutes",
          "human_estimate_minutes",
          "repo",
          "branch",
          "spec_link",
          "plan_link",
          "pr_link",
          "started_at",
          "completed_at",
          "actual_minutes",
          "rework_count",
          "estimate_ratio",
          "human_speedup"
        ]
      },
      "states": {
        "backlog": "Backlog",
        "blocked": "In Progress",
        "done": "Done",
        "dropped": "Canceled",
        "in-progress": "In Progress",
        "in-review": "In Progress",
        "planned": "Todo",
        "specced": "Todo"
      },
      "state_labels": {
        "blocked": "blocked",
        "in-review": "in-review",
        "planned": "planned",
        "specced": "specced"
      },
      "tools": {
        "comment": "mcp__Linear__save_comment",
        "create": "mcp__Linear__save_issue",
        "read": "mcp__Linear__get_issue",
        "search": "mcp__Linear__list_issues",
        "update": "mcp__Linear__save_issue"
      }
    },
    "notion": {
      "container": {
        "data_source_id": "<data source ID of the ticket database>"
      },
      "fields": {
        "actual_minutes": "Actual minutes",
        "assist": "Assist",
        "branch": "Branch",
        "estimate_minutes": "Estimate minutes",
        "human_estimate_minutes": "Human estimate minutes",
        "human_speedup": "Human speedup",
        "estimate_ratio": "Estimate ratio",
        "model": "Model",
        "repo": "Repo",
        "rework_count": "Rework count",
        "tier": "Tier"
      },
      "states": {
        "backlog": "Backlog",
        "blocked": "Blocked",
        "done": "Done",
        "dropped": "Dropped",
        "in-progress": "In progress",
        "in-review": "In review",
        "planned": "Planned",
        "specced": "Specced"
      },
      "tools": {
        "comment": "mcp__Notion__notion-create-comment",
        "create": "mcp__Notion__notion-create-pages",
        "read": "mcp__Notion__notion-fetch",
        "search": "mcp__Notion__notion-query-data-sources",
        "update": "mcp__Notion__notion-update-page"
      }
    }
  }
}
