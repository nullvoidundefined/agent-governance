#!/usr/bin/env bash
# Git pre-push hook for the agent-governance repo: a stale Cursor or Codex
# port aborts the push.
#
# Tracked as a sample because .git/hooks is not version-controlled, so it cannot
# ship installed. Install it with:
#
#   bash ~/.claude/hooks/install-git-hooks.sh /path/to/checkout
#
# The fixture suites do not run here (IAN-98, 2026-09-18). They are the
# required `fixtures` check in .github/workflows/enforce.yml, which a push
# cannot skip, and running them locally as well doubled every push's wait;
# the turn-end gate already ran the fixtures each change affects. The port
# checks stay, because they take seconds and nothing else local catches a
# port left stale by an edit made outside a session.
#
# After editing this sample, re-run the installer to upgrade the copy git
# actually runs; nothing else refreshes it, and until it is re-run the checks
# added here enforce nothing in a repository that installed an older copy:
#
#   bash ~/.claude/hooks/install-git-hooks.sh /path/to/checkout
set -uo pipefail

# git feeds pre-push the refs being pushed on stdin, one
# `<local ref> <local sha> <remote ref> <remote sha>` line per ref. It is read
# once, here, into a file: stdin can be consumed only once, and the cited-SHA
# gate below needs the same list.
PUSH_REFS=$(mktemp)
trap 'rm -f "$PUSH_REFS"' EXIT
cat > "$PUSH_REFS"

# git runs pre-push with cwd at the repo toplevel; resolve it explicitly
# anyway so the hook also behaves when invoked by hand.
TOP=$(git rev-parse --show-toplevel 2>/dev/null) || TOP="$PWD"

fail=0

# The port checks come from enforce/port-checks.sh, the one inventory the
# turn-end gate and CI also read, so a port added to the repository is checked
# everywhere at once instead of in whichever caller someone remembered
# (2026-09-18 external audit, finding 7). translate/ lives beside claude/ in
# the monorepo layout only; a legacy or live-copy checkout carries no
# translator, the inventory emits nothing there, and this step is silently
# skipped rather than failing on a missing script.
PORT_CHECKS_HELPER="$TOP/claude/enforce/port-checks.sh"
[ -f "$PORT_CHECKS_HELPER" ] || PORT_CHECKS_HELPER="$TOP/enforce/port-checks.sh"
if [ -f "$PORT_CHECKS_HELPER" ]; then
  # shellcheck source=/dev/null
  . "$PORT_CHECKS_HELPER"
  while IFS= read -r port_check; do
    [ -n "$port_check" ] || continue
    if ! ( cd "$TOP" && eval "$port_check" ); then
      fail=1
    fi
  done <<< "$(listPortChecks "$TOP")"
fi

# R-215: a commit SHA cited in a document is a promise that the commit can be
# fetched, and this is the only boundary where the promise can still be
# checked. The objects behind an unreachable citation exist in the author's
# clone and nowhere else, so by the time CI or a reader could ask the question,
# the answer is already gone.
#
# The refs on stdin are what the check reads, and it reads the documents as the
# pushed COMMITS carry them. The working tree is not the subject: what is about
# to become public is the commit, and a committed unreachable citation that an
# uncommitted edit happens to hide is exactly the case this must catch (R-517
# review of PR #118). Only the documents those commits change are read, so the
# historical corpus, which cites commits whose branches were deleted long ago,
# does not block a push about something else; `--all` reports that backlog.
#
# Exit 2 aborts the push as exit 1 does. It means the check declined to judge
# (a shallow clone, an unreadable document, a resolver that failed), and a
# question that cannot be answered must not be recorded as an answer of "fine".
DOC_SHA_CHECK="$TOP/claude/enforce/doc-sha-reachability.sh"
[ -f "$DOC_SHA_CHECK" ] || DOC_SHA_CHECK="$TOP/enforce/doc-sha-reachability.sh"
if [ -f "$DOC_SHA_CHECK" ]; then
  ( cd "$TOP" && bash "$DOC_SHA_CHECK" --push "${1:-origin}" < "$PUSH_REFS" )
  doc_sha_status=$?
  if [ "$doc_sha_status" -ne 0 ]; then
    [ "$doc_sha_status" -eq 1 ] || echo "pre-push: the cited-SHA check declined to judge this push (exit $doc_sha_status); its reason is above." >&2
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: port checks or the cited-SHA check are red; push aborted." >&2
  echo "Fix the failure. Do not weaken the gate that caught it (R-204)." >&2
  exit 1
fi
exit 0
