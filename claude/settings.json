{
  "permissions": {
    "allow": [
      "Bash",
      "Bash(*)",
      "Bash(awk *)",
      "Bash(bash *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(chmod +x *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(date*)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(env *)",
      "Bash(export *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ln *)",
      "Bash(ls*)",
      "Bash(lsof *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(perl *)",
      "Bash(pnpm *)",
      "Bash(printf *)",
      "Bash(ps *)",
      "Bash(python3 *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(sh *)",
      "Bash(tail *)",
      "Bash(time *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(xargs *)",
      "Bash(yarn *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm ~/.claude/hooks/*)",
      "Bash(rm -rf ~/.claude/hooks*)",
      "Bash(chmod -x ~/.claude/hooks/*)",
      "Bash(git push --mirror*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh repo edit --visibility public*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh auth token*)",
      "Bash(gh alias set*)",
      "Bash(security find-generic-password*)"
    ],
    "ask": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-repo*)",
      "Bash(git filter-branch*)",
      "Bash(uvx git-filter-repo*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review --approve*)",
      "Bash(gh secret set*)",
      "Bash(gh variable set*)",
      "Bash(gh extension install*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh issue delete*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh ssh-key add*)",
      "Bash(gh gpg-key add*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(chmod -R 777*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-em-dash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/fix-commit-requires-test.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/conflict-markers.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-message-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-db-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-command-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/global-repo-push-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/push-eslint-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/push-ruff-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/push-rubocop-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/push-golangci-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/constant-change-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-signal-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/llm-rule-judge.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/single-file-folder-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/build-cheatsheets.sh",
            "timeout": 60,
            "statusMessage": "Rebuilding feature cheat sheets"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-em-dash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/migration-defaults-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/structure-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/content-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mcp-action-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/redact-output.sh",
            "statusMessage": "Scanning output for secrets..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/new-file-header-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/flat-directory-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/spec-glossary-check.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/clean-code-reminder.sh"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/task-commit-reminder.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/hookspath-drift-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/redaction-guard-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforcement-guard-check.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/hook-integrity-check.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ntfy-notify.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ntfy-notify.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-compact-rules.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "posthog@claude-plugins-official": false,
    "stripe@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
