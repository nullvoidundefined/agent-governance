{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./sync.sh)",
      "Bash(awk *)",
      "Bash(basename *)",
      "Bash(bash -n *)",
      "Bash(bash claude/enforce/tests/*)",
      "Bash(bash claude/hooks/tests/*)",
      "Bash(bash enforce/tests/*)",
      "Bash(bash hooks/tests/*)",
      "Bash(cargo build*)",
      "Bash(cargo check*)",
      "Bash(cargo clippy*)",
      "Bash(cargo test*)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(chmod +x *)",
      "Bash(cmp *)",
      "Bash(column *)",
      "Bash(comm *)",
      "Bash(command -v *)",
      "Bash(cp *)",
      "Bash(cut *)",
      "Bash(date*)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(docker build *)",
      "Bash(docker compose logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker images*)",
      "Bash(docker info*)",
      "Bash(docker logs *)",
      "Bash(docker ps*)",
      "Bash(docker version*)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(export *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ln *)",
      "Bash(ls*)",
      "Bash(lsof *)",
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(mypy *)",
      "Bash(node translate/*)",
      "Bash(npm *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(pip list*)",
      "Bash(pip show *)",
      "Bash(pnpm *)",
      "Bash(printf *)",
      "Bash(ps *)",
      "Bash(pwd)",
      "Bash(pytest *)",
      "Bash(python3 - *)",
      "Bash(python3 -c *)",
      "Bash(railway logs *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(ruff *)",
      "Bash(sed *)",
      "Bash(seq *)",
      "Bash(sha256sum *)",
      "Bash(shasum *)",
      "Bash(shellcheck *)",
      "Bash(sleep *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(time *)",
      "Bash(touch *)",
      "Bash(tr *)",
      "Bash(tree *)",
      "Bash(tree)",
      "Bash(true)",
      "Bash(uname *)",
      "Bash(uname)",
      "Bash(uniq *)",
      "Bash(uv sync*)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(yarn *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm ~/.claude/hooks/*)",
      "Bash(rm -rf ~/.claude/hooks*)",
      "Bash(chmod -x ~/.claude/hooks/*)",
      "Bash(git push --mirror*)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config --global core.hooksPath *)",
      "Bash(git config --local core.hooksPath *)",
      "Bash(git config --worktree core.hooksPath *)",
      "Bash(git config --unset*core.hooksPath*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh repo edit --visibility public*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh auth token*)",
      "Bash(gh alias set*)",
      "Bash(security find-generic-password*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-repo*)",
      "Bash(git filter-branch*)",
      "Bash(uvx git-filter-repo*)",
      "Bash(gh pr review --approve*)",
      "Bash(gh secret set*)",
      "Bash(gh variable set*)",
      "Bash(gh extension install*)",
      "Bash(gh release create*)",
      "Bash(gh release edit*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh issue delete*)",
      "Bash(gh ssh-key add*)",
      "Bash(gh gpg-key add*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(chmod -R 777*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(railway up*)",
      "Bash(railway redeploy*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(wrangler deploy*)",
      "Bash(fly deploy*)",
      "Bash(flyctl deploy*)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(bash -lc *)",
      "Bash(sh -lc *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api * pulls/*/merge*)",
      "Bash(docker build *--push*)"
    ],
    "defaultMode": "auto"
  },
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "api.anthropic.com",
        "registry.npmjs.org"
      ]
    },
    "excludedCommands": [
      "git push",
      "git fetch",
      "git pull"
    ],
    "filesystem": {
      "allowWrite": [
        "//var/folders/**",
        "//private/tmp/**",
        "//tmp/**"
      ]
    }
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/status-line.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-dispatch-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/conflict-markers.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-db-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-command-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/codex-billing-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/global-repo-push-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/git-workflow-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-ops-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/infra-mutation-guard.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protected-path-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/secret-scan.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-em-dash.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protected-path-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dependency-add-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/mcp-action-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-db-guard.sh"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protected-path-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-watchdog-instruction.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/redact-output.sh",
            "statusMessage": "Scanning output for secrets..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit-log.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/harness-sync.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/turn-summary-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/claim-check-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claim-check-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "posthog@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
