# macOS
.DS_Store

# Ephemeral / machine-specific state
.last-cleanup
.session-locks/
.verify-memo/
backups/
cache/
debug/
file-history/
gh-pr-status-cache.json
history.jsonl
ide/
image-cache/
mcp-needs-auth-cache.json
paste-cache/
session-env/
sessions/
shell-snapshots/
stats-cache.json
tasks/
telemetry/
todos/
# Rule fire and miss logs: hooks/session-end.sh appends to the live copies at
# every session end, so a tracked copy never matched the live tree, harness-sync
# saw drift at every SessionStart, and each sync overwrote the live logs
# (IAN-114). session-end.sh creates each one with its header when absent.
global-memory/rule_fires.md
global-memory/rule_misses.md

# Per-session user uploads: arbitrary user-supplied files (photos, documents,
# screenshots) keyed by session id. Never publishable (R-106).
uploads/

# Local settings (may contain secrets / machine-specific permissions)
settings.local.json
.env
.env.*

# Plugins are managed by Claude Code and reinstallable from settings.json
plugins/

# Per-project session data and memory (contains user-specific paths and project details)
projects/

# Private operational logs (contain infrastructure-specific deployment details)
KNOWN-ISSUES.md

# Ticket tracker instance config (project keys, workspace and data source IDs
# identify a client; R-106). TICKET-TRACKER.template.json is the tracked template.
TICKET-TRACKER.json

# Plans are ephemeral session artifacts
plans/

# Daemon/background runtime artifacts (contain machine and client paths)
daemon.lock
daemon.log
daemon.status.json
daemon.json
daemon-*
daemon/
jobs/
chrome/

# Client-identifying enforce lists (R-106: remote is public)
enforce/exempt-repos.txt
enforce/mcp-database-targets.txt
enforce/colocated-test-repos.txt
